{
  "include": [
    "src",
    "**/*.d.ts",
    "src/**/*.ts",
    "./babel.config.js",
    "globals/theme/Styled.d.ts",
    "./App.tsx",
    "utils/*.ts"
  ],
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@Screens/*": ["src/screens/*"],
      "@Redux/*": ["src/redux/*"],
      "@Services/*": ["src/services/*"],
      "@Assets/*": ["assets/*"],      
      "@Globals/*": ["globals/*"],       
      "@Utils/*": ["utils/*"]
    }
  },
  "extends": "expo/tsconfig.base",
  "exclude": ["node_modules"]
}
