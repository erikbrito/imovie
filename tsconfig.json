{
  "include": [
    "src",
    "**/*.d.ts",
    "src/**/*.ts",
    "./babel.config.js",
    "Global/Theme/Styled.d.ts",
    "./App.tsx",
    "Utils/*.ts"
  ],
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@Screens/*": ["src/Screens/*"],
      "@Redux/*": ["src/Redux/*"],
      "@Services/*": ["src/Services/*"],
      "@Components/*": ["Global/Components/*"],
      "@Assets/*": ["assets/*"],
      "@Global/*": ["Global/*"],
      "@Utils/*": ["Utils/*"]
    }
  },
  "extends": "expo/tsconfig.base",
  "exclude": ["node_modules"]
}
